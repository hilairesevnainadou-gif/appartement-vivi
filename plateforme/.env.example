APP_NAME="Appartement VIVI"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=vivi
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Emails (codes de connexion, confirmations)
# En local : serveur SMTP de DevLauncher (127.0.0.1:2525), les emails s'affichent dans DevLauncher.
# Sans DevLauncher : MAIL_MAILER=log, les emails sont écrits dans storage/logs/laravel.log.
# En production, offre gratuite Brevo (300 emails/jour) : créer un compte sur brevo.com,
# puis Paramètres SMTP & API > générer une clé SMTP, et remplir :
#   MAIL_MAILER=smtp  MAIL_HOST=smtp-relay.brevo.com  MAIL_PORT=587
#   MAIL_USERNAME=<identifiant SMTP Brevo>  MAIL_PASSWORD=<clé SMTP Brevo>
# L adresse d'expédition doit être validée dans Brevo (domaine ou adresse).
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="no-reply@appartement-vivi.bj"
MAIL_FROM_NAME="VIVI"

# Connexion « avec Google » des clients (console.cloud.google.com › API et services › Identifiants)
# Identifiant client « Application Web », URI de redirection autorisée : {APP_URL}/connexion/google/retour
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
# Identifiants client « Android » de l'application (séparés par des virgules), acceptés pour POST /api/v1/auth/google
GOOGLE_CLIENTS_ANDROID=
# Push Android : projet Firebase et fichier JSON du compte de service (ex. storage/app/firebase.json)
FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS=

# SMS : « log » (rien n'est envoyé, le SMS est écrit dans le journal) ou « smsto » (payant à l'usage)
VIVI_SMS_PILOTE=log
SMSTO_API_KEY=
SMSTO_EXPEDITEUR=VIVI

# En local seulement : afficher le code de connexion à l'écran pour tester
VIVI_AFFICHER_CODE_LOCAL=true

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Premier administrateur (php artisan db:seed)
ADMIN_EMAIL=admin@appartement-vivi.local
ADMIN_PASSWORD=


# Paiement : « simulation » en local (rien n est débité) ou « fedapay » (clés sandbox puis live)
VIVI_PAIEMENT_PILOTE=simulation
# « sandbox » ou « live », jamais une clé. La clé secrète commence par sk_ ; la clé publique (pk_) ne sert pas.
FEDAPAY_ENVIRONMENT=sandbox
FEDAPAY_SECRET_KEY=
FEDAPAY_WEBHOOK_SECRET=

# Contact du service client (modifiable ensuite dans Administration > Paramètres)
VIVI_WHATSAPP=
VIVI_EMAIL_CONTACT=

# Surveillance : email de secours si la base de données est en panne ; alerte si le cron schedule:run ne tourne plus (production)
VIVI_EMAIL_ALERTES=
VIVI_SURVEILLER_PLANIFICATEUR=
